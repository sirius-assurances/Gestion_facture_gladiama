generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
  schemas  = ["facturation"]
}

model Client {
  id               String    @id @default(uuid())
  name             String
  location         String    @default("Dakar, Sénégal")
  phone            String?
  email            String?
  projectName      String?
  marketNumber     String?
  contractNumber   String?
  defaultProduct   String    @default("Latérite crue")
  defaultUnitPrice Decimal   @default(600) @db.Decimal(15, 2)
  hasTva           Boolean   @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  createdByEmail   String?
  updatedByEmail   String?
  invoices         Invoice[]

  @@schema("facturation")
  @@index([name])
}

model Invoice {
  id            String        @id @default(uuid())
  clientId      String
  invoiceNumber String        @unique
  invoiceDate   DateTime      @default(now())
  periodStart   DateTime
  periodEnd     DateTime
  dueDate       DateTime
  hasTva        Boolean       @default(false)
  tvaRate       Decimal       @default(18) @db.Decimal(5, 2)
  totalHt       Decimal       @default(0) @db.Decimal(15, 2)
  totalTva      Decimal       @default(0) @db.Decimal(15, 2)
  totalTtc      Decimal       @default(0) @db.Decimal(15, 2)
  status        InvoiceStatus @default(DRAFT)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  createdByEmail String?
  updatedByEmail String?
  client        Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  items         InvoiceItem[]

  @@schema("facturation")
  @@index([clientId])
  @@index([status])
  @@index([createdAt])
  @@index([dueDate])
}

model InvoiceItem {
  id          String  @id @default(uuid())
  invoiceId   String
  designation String  @default("Fourniture latérite crue")
  quantity    Decimal  @db.Decimal(15, 3)
  unit        String  @default("m³")
  unitPrice   Decimal  @db.Decimal(15, 2)
  total       Decimal  @db.Decimal(15, 2)
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@schema("facturation")
  @@index([invoiceId])
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID

  @@schema("facturation")
}
