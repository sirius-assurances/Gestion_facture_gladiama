# Supabase PostgreSQL pooler URL used by the application.
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@[POOLER_HOST]:6543/postgres?pgbouncer=true"
# Direct Supabase connection used by Prisma migrations.
DIRECT_DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@[DB_HOST]:5432/postgres"

NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT_REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="[SUPABASE_ANON_KEY]"

# Company details printed on invoices and share messages. Optional —
# lib/company.ts falls back to the registered values. Keep any override in
# step with the invoice footer image, which is what the client reads.
# NEXT_PUBLIC_COMPANY_EMAIL="abdoulayedrame1@hotmail.com"
# NEXT_PUBLIC_COMPANY_PHONE="+221 77 704 37 90"
# NEXT_PUBLIC_COMPANY_ADDRESS="Cité Soleil Dalifort Villa N°38"

# Invoice email sending. SMTP_SERVICE fills in host and port for a known
# provider (gmail, outlook, hotmail, resend); SMTP_HOST/SMTP_PORT override it.
# The password must be an app password, never the account password — mailbox
# providers reject the real one and an app password can be revoked alone.
# Mail goes through the mailbox's own provider so SPF and DKIM pass: a relay
# claiming to be @gmail.com or @hotmail.com is rejected or filed as spam.
# SMTP_SERVICE="gmail"
# SMTP_USER="vous@gmail.com"
# SMTP_PASSWORD="[APP_PASSWORD]"
# Optional. The sender defaults to SMTP_USER and the name to the company.
# SMTP_FROM_EMAIL="facturation@votredomaine.com"
# SMTP_FROM_NAME="GLADIAMA SUARL"
# SMTP_REPLY_TO="reponses@votredomaine.com"

# Inserts the demo clients and invoices N°22-24 into an empty database.
# Leave unset on any database holding real invoices.
# ENABLE_DEMO_SEED="1"

# End-to-end tests (npm run test:e2e). An existing Supabase Auth account.
E2E_EMAIL="[TEST_ACCOUNT_EMAIL]"
E2E_PASSWORD="[TEST_ACCOUNT_PASSWORD]"
# Optional: run against a deployed instance instead of the local dev server.
# E2E_BASE_URL="https://gestion-facture-gladiama.vercel.app"
# Only set this against a disposable database: the lifecycle test creates an
# invoice, which consumes a number from the real invoice sequence.
# E2E_ALLOW_WRITES="1"